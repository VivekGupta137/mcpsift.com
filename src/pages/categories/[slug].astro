---
import { Link } from '@heroui/react';
import Layout from '../../layouts/Layout.astro';
import Catalog from '../../components/Catalog';
import { cardData, getEntries } from '../../lib/content';
import { categoryDescription, categorySlug, categoryTitle } from '../../lib/landing';

export async function getStaticPaths() {
  const entries = await getEntries('server');
  entries.sort((a, b) => (b.repositoryStats?.stars || 0) - (a.repositoryStats?.stars || 0));
  const categories = [...new Set(entries.map(entry => entry.category))];
  return categories.map(category => ({ params: { slug: categorySlug(category) }, props: { category, entries: entries.filter(entry => entry.category === category) } }));
}
const { category, entries } = Astro.props;
const title = categoryTitle(category);
const description = categoryDescription(category);
---
<Layout title={title} description={description} active="directory" kind="directory" entries={entries.slice(0, 24)}>
  <main id="main" class="guides-page" data-pagefind-body>
    <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore><Link href="/">Directory</Link><span>/</span><span aria-current="page">{category}</span></nav>
    <section class="hero guides-hero"><span class="eyebrow">MCP SERVER CATEGORY · {entries.length} LISTED</span><h1>{title}</h1><p class="hero-description">{description} Use the repository link on each listing to verify current installation, compatibility, and permissions.</p></section>
    <Catalog entries={entries.slice(0, 24).map(cardData)} catalogUrl={`/catalog/category/${categorySlug(category)}.json`} kind="server" client:load />
  </main>
</Layout>
