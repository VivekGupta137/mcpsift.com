---
import Layout from '../layouts/Layout.astro';
import MarkdownContent from '../components/MarkdownContent';
import { ActionLink } from '../components/Chrome';
import { getPage, repositoryUrl } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';
const page = await getPage('about');
const [intro, ...sections] = page.body.split(/(?=^## )/m);
---
<Layout title="About & contributions" description={page.description} active="about" kind="about" seo={page.seo} updated={page.updated}>
  <main id="main" class="about-page"><header class="hero"><span class="eyebrow">{page.eyebrow}</span><h1>{page.title}</h1><div class="hero-description" set:html={renderMarkdown(intro).html} /></header>
    <div class="about-grid">{sections.slice(0, 2).map(section => <section class="panel"><MarkdownContent html={renderMarkdown(section).html} client:visible /></section>)}</div>
    <section class="contribution-section">{sections.slice(2).map(section => <MarkdownContent html={renderMarkdown(section).html} client:visible />)}{repositoryUrl ? <ActionLink href={`${repositoryUrl}/issues/new`} icon="github" primary>Suggest on GitHub</ActionLink> : <p class="repository-notice">Repository contributions will be available when the site owner connects this directory’s GitHub repository.</p>}</section>
    <aside class="publishing-note"><strong>Reviewed in GitHub. Published on the next build.</strong><p>Server entries, guides, and page content are maintained as Markdown in the repository.</p></aside>
  </main>
</Layout>
